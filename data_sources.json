{
  "_schema": "1.0",
  "_description": "钛星数据源配置文件。按7个板块分类，每个数据源定义名称、爬虫函数、类型和描述。",
  "_usage": "新增数据源：在对应板块的 sources 数组中添加一条记录，然后在 fetch_data.py 中实现对应的爬虫函数。",
  "_boards": [
    "rocket",
    "moon",
    "controlled-fusion",
    "semiconductor",
    "china-tech",
    "mega-projects",
    "finance"
  ],
  "boards": {
    "rocket": {
      "name": "可回收火箭",
      "name_en": "Reusable Rockets",
      "output_file": "rocket.json",
      "sources": [
        {
          "id": "rocket_launches",
          "name": "火箭发射日历",
          "crawler": "crawl_rocket_launches",
          "type": "api",
          "description": "Launch Library 2 API，抓取全球火箭发射排期",
          "enabled": true,
          "sleep_after": 1
        },
        {
          "id": "rocket_news",
          "name": "火箭公司新闻",
          "crawler": "crawl_rocket_news_snapi",
          "type": "api",
          "description": "Spaceflight News API (SNAPI)，聚合 SpaceX/Blue Origin/Rocket Lab/Relativity/Stoke Space 新闻（20+ 权威来源）",
          "enabled": true,
          "sleep_after": 1
        },
        {
          "id": "spacechina_launches",
          "name": "长征系列运载火箭发射记录",
          "crawler": "crawl_spacechina_launches",
          "type": "html",
          "description": "航天科技集团官网，国内长征系列发射记录（纯中文官方数据，不依赖 LL2，无限流风险；只有历史已完成记录，无未来计划）",
          "enabled": true,
          "sleep_after": 1
        }
      ]
    },
    "moon": {
