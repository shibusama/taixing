        {
          "id": "rocket_launches",
          "name": "火箭发射日历",
          "crawler": "crawl_rocket_launches",
          "type": "api",
          "description": "Launch Library 2 API，抓取全球火箭发射排期",
          "enabled": true,
          "sleep_after": 1
        },
        {
          "id": "spacex",
          "name": "SpaceX",
          "crawler": "crawl_spacex",
